# ClearSpeak environment. Copy to .env.local (gitignored) or mise.local.toml.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
APP_ACCESS_CODE=
# Server-side history storage directory (SQLite). Production must set this explicitly.
# Production: /home/ubuntu/data/clearspeak
# Staging: /home/ubuntu/data/clearspeak-staging
CLEARSPEAK_DATA_DIR=
# AZURE_ENABLE_PROSODY=false
