# ClearSpeak environment. Copy to .env.local (gitignored) or mise.local.toml.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
APP_ACCESS_CODE=
# Server-side history storage directory (SQLite). Production must set this explicitly.
# Production: /home/ubuntu/data/clearspeak
# Staging: /home/ubuntu/data/clearspeak-staging
CLEARSPEAK_DATA_DIR=
# AZURE_ENABLE_PROSODY=false
# Milestone 5 Track B pilot (disabled by default). Set to 1 at build time to
# show one extra deterministic coaching note. Unset or 0 hides it without
# breaking results. Restart/rebuild after changing any NEXT_PUBLIC_* value.
# NEXT_PUBLIC_ENABLE_EXTRA_COACHING=0
