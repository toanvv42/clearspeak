[Unit]
Description=ClearSpeak pronunciation coach
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/pronunciation-coach
Environment=HOME=/home/ubuntu
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=CLEARSPEAK_DATA_DIR=/home/ubuntu/data/clearspeak
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/mise exec -- npm run start -- --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
